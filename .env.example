# Copy to .env and fill in. Never commit .env.
# The bot loads these via pydantic-settings.

# --- Arbitrum RPC (primary + fallback, comma-separated) ---
ARBITRUM_RPC_PRIMARY=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK=https://arbitrum-one.publicnode.com

# --- Wallets ---
# Master wallet: signs Aave txs, bridge deposits, HL withdrawals.
BOT_MASTER_ADDRESS=0x0000000000000000000000000000000000000000
BOT_MASTER_PRIVATE_KEY=

# Hyperliquid agent wallet: signs orders only, no withdrawal rights.
HL_AGENT_ADDRESS=0x0000000000000000000000000000000000000000
HL_AGENT_PRIVATE_KEY=

# --- Telegram alerts ---
TG_TOKEN=
TG_CHAT=

# --- Runtime ---
# DRY_RUN | LIVE_SMALL | LIVE
DELTA0_MODE=DRY_RUN
